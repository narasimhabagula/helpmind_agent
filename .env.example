# HelpMind AI — Secure Server-Side Environment Variables
# Configure these variables in your deployment / Lovable Secrets settings.
# IMPORTANT: These keys are strictly server-side and are NEVER exposed to the browser or client bundle.

# Google Gemini API Key (LLM response generation & customer reasoning)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Hindsight Cloud API Key (Persistent vector & episodic customer memory)
HINDSIGHT_API_KEY=MY_HINDSIGHT_API_KEY

# Hindsight Configuration
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=supportmind
